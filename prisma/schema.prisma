// Database schema for the Habitat Signup System.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BuildStatus {
  DRAFT // visible to admins only
  PUBLISHED // open for signups
  CLOSED // visible, but no longer accepting signups
  CANCELLED
}

enum SignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum Sex {
  FEMALE
  MALE
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum MessageChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ─── Admins ──────────────────────────────────────────────────────────────────

// Staff who can log in to the admin dashboard. Better Auth uses this as its
// "user" model, so emailVerified and image are fields it requires.
// Admins are invite-only: logging in never creates a new Admin row.
model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false) // set true after the first magic-link login
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  builds   Build[]
  messages Message[]
}

// ─── Auth (managed by Better Auth) ───────────────────────────────────────────
// Field names follow Better Auth's schema, so userId refers to an Admin.

// A logged-in browser. The cookie holds the token; deleting the row logs out.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   Admin  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A sign-in method linked to an admin. Unused by magic links, but part of
// Better Auth's core schema (it would hold passkeys or Google sign-in).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   Admin  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived one-time values, such as magic-link tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Builds & shifts ─────────────────────────────────────────────────────────

// A home Habitat is building. Volunteers sign up for its shifts.
model Build {
  id          String      @id @default(cuid())
  name        String
  address     String
  description String?     @db.Text
  // IANA time zone the build's shift times are entered and shown in.
  timeZone    String      @default("America/Indiana/Indianapolis")
  status      BuildStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdById String
  createdBy   Admin  @relation(fields: [createdById], references: [id])

  shifts Shift[]

  @@index([status])
}

// A block of time volunteers can sign up for at a build.
model Shift {
  id          String    @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int // total volunteer spots; group signups use groupSize spots
  notes       String?   @db.Text
  // Shifts with signups are cancelled rather than deleted, to keep a record.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  buildId String
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)

  signups  Signup[]
  messages Message[]

  @@index([buildId, startsAt])
}

// ─── Volunteers & signups ────────────────────────────────────────────────────

// Volunteers never log in. A returning volunteer is matched by email, and
// each signup updates their details to the latest ones entered. The signup
// form requires most fields; they're optional here for volunteers added in
// other ways (such as group members).
model Volunteer {
  id                    String      @id @default(cuid())
  firstName             String
  lastName              String
  email                 String      @unique
  phone                 String? // E.164, e.g. +17655550123
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String? // E.164
  sex                   Sex?
  tShirtSize            TShirtSize?
  smsOptIn              Boolean     @default(false)
  smsOptInAt            DateTime? // when consent was given (needed for SMS compliance)
  dateOfBirth           DateTime?   @db.Date
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  signups           Signup[]
  groupMemberships  GroupMember[]
  waiverAcceptances WaiverAcceptance[]
  messageRecipients MessageRecipient[]
}

// One volunteer signing up for one shift: either alone, or as the leader of
// a group (groupSize > 1) that takes up several spots.
model Signup {
  id          String       @id @default(cuid())
  status      SignupStatus @default(CONFIRMED)
  groupName   String? // e.g. "First Baptist Youth Group"; null for individuals
  groupSize   Int          @default(1) // includes the leader
  // Secret token for the "view or cancel your signup" link in the confirmation email.
  manageToken String       @unique @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cancelledAt DateTime?

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  volunteerId String // the individual, or the group leader
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])

  groupMembers      GroupMember[]
  waiverAcceptances WaiverAcceptance[]

  @@unique([shiftId, volunteerId])
  @@index([volunteerId])
}

// A member of a group signup, other than the leader. The leader may know only
// a name at signup time; the member is linked to a Volunteer record once they
// open their waiver link and fill in their details.
model GroupMember {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  dateOfBirth DateTime? @db.Date
  // Secret token for this member's personal waiver link.
  waiverToken String    @unique @default(uuid())
  createdAt   DateTime  @default(now())

  signupId String
  signup   Signup @relation(fields: [signupId], references: [id], onDelete: Cascade)

  volunteerId String?
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id])

  @@index([signupId])
}

// ─── Waivers ─────────────────────────────────────────────────────────────────

// Waiver text is versioned and never edited in place. To change the text,
// create a new version and make it the active one.
model Waiver {
  id        String   @id @default(cuid())
  version   Int      @unique
  title     String
  body      String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  acceptances WaiverAcceptance[]
}

// An immutable record of a volunteer accepting a specific waiver version.
model WaiverAcceptance {
  id         String   @id @default(cuid())
  signedName String // typed-name signature
  signedAt   DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  // Minors: a parent or guardian accepts on their behalf.
  isMinor              Boolean @default(false)
  guardianName         String?
  guardianEmail        String?
  guardianRelationship String?

  waiverId String
  waiver   Waiver @relation(fields: [waiverId], references: [id])

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])

  // The signup during which the waiver was accepted, if any.
  signupId String?
  signup   Signup? @relation(fields: [signupId], references: [id], onDelete: SetNull)

  @@index([volunteerId, waiverId])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

// An email or text sent by an admin, usually to everyone signed up for a shift.
model Message {
  id        String         @id @default(cuid())
  channel   MessageChannel
  subject   String? // email only
  body      String         @db.Text
  createdAt DateTime       @default(now())

  sentById String
  sentBy   Admin  @relation(fields: [sentById], references: [id])

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  recipients MessageRecipient[]
}

// Delivery status for each recipient of a message.
model MessageRecipient {
  id         String         @id @default(cuid())
  to         String // email address or phone number at send time
  status     DeliveryStatus @default(QUEUED)
  providerId String? // Resend / Twilio message ID
  error      String?
  updatedAt  DateTime       @updatedAt

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])

  @@index([messageId])
}
