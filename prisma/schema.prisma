// Database schema for the Habitat Signup System.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

// Only admins sign in. Kept as a field so the sign-in check stays explicit.
enum Role {
  ADMIN
}

// Whether volunteers can see a signup form. When they can fill it out is set
// by its open and close times.
enum FormStatus {
  DRAFT // admins only
  PUBLISHED // listed on the home page until it closes
  CANCELLED // the event is off: volunteers are told on the form's page; final
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

// How a volunteer is getting to the build site, from their signup.
enum Transportation {
  NEEDS_RIDE // needs help getting there
  OWN_WAY // getting there on their own
  CAN_DRIVE // has a car and can drive others (only offered to pending or approved drivers)
}

// An admin's decision on a volunteer's Purdue driver approval.
enum DriverDecision {
  APPROVED
  DECLINED
}

enum MessageChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ─── Users ───────────────────────────────────────────────────────────────────

// An admin, who signs in with an emailed code. Admins are added by the
// admin:add script, never from a form; volunteers don't have accounts (see
// Volunteer). Better Auth uses this as its "user" model, so name,
// emailVerified and image are fields it requires.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(ADMIN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // Admin activity.
  formsCreated    SignupForm[]
  driverDecisions DriverApproval[]
  messagesSent    Message[]
}

// ─── Auth (managed by Better Auth) ───────────────────────────────────────────
// Field names follow Better Auth's schema.

// A logged-in browser. The cookie holds the token; deleting the row logs out.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A sign-in method linked to a user. Unused by email codes, but part of
// Better Auth's core schema (it would hold passkeys or Google sign-in).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived one-time values, such as hashed sign-in codes.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// One request for a sign-in code, kept briefly to limit how often codes can
// be sent to an email address or from an IP address.
model LoginCodeRequest {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ─── Signup forms ────────────────────────────────────────────────────────────

// A signup form for a build day, with the builds volunteers choose from.
// A day can have several forms, such as one for an outside group that signs
// up apart from everyone else; each is separate, with its own builds and
// signups, and its own name to tell it apart. A volunteer can only be
// signed up on one form a day.
model SignupForm {
  id          String     @id @default(cuid())
  // Unique among the forms on its day, ignoring case.
  name        String
  // The build day, in the Indiana time zone.
  date        DateTime   @db.Date
  description String?    @db.Text
  status      FormStatus @default(DRAFT)
  // Volunteers can fill it out from opensAt until closesAt. A published form
  // is visible before it opens: listed on the home page, unless it isn't
  // listed, and then only through its link.
  opensAt     DateTime
  closesAt    DateTime
  listed      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The admin who created the form. Their name is copied here when the form
  // is created, so it stays the same if they're later renamed, lose admin
  // access, or their account is deleted.
  createdByName String
  createdById   String?
  createdBy     User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // When an admin cancelled the event, and their name, copied as above.
  // Volunteers signed up then were emailed.
  cancelledAt     DateTime?
  cancelledByName String?

  // Which optional questions the form asks. Without the transportation
  // questions (for a group that gets itself there), nobody is asked how
  // they're getting there or for driver approval, and everyone counts as
  // getting there on their own. Without the friends question, nobody is
  // asked who they'd like to be placed with, and earlier requests are
  // ignored. Either can change after signups; answers given are kept.
  askTransportation Boolean @default(true)
  askGroups         Boolean @default(true)

  // When an admin saved custom assignments, after the form closed, and
  // their name, copied as above. Until then (or after reverting), each
  // volunteer's build comes from the app's placement (src/lib/placement);
  // once saved, it's each signup's assignedShift.
  assignmentsSavedAt     DateTime?
  assignmentsSavedByName String?

  shifts   Shift[]
  sections FormSection[]
  signups  FormSignup[]

  @@index([status, date])
  @@index([date])
}

// One of the builds on a form's day: a group working at one address, which
// volunteers can say they'd work at. The app calls it a "build"; the code
// still calls it a shift. Volunteers don't sign up for one directly: they
// say on the form which builds they could work at.
model Shift {
  id          String    @id @default(cuid())
  name        String
  address     String
  description String?   @db.Text
  // What volunteers do for lunch there, such as "Bring a packed lunch".
  lunch       String?   @db.Text
  // On the form's day, entered and shown in Indiana time.
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int // volunteer spots
  // Builds volunteers have chosen are cancelled rather than deleted, to keep
  // a record. A cancelled build isn't offered on its form.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Forms with signups can't be deleted, so this only removes builds nobody
  // chose.
  formId String
  form   SignupForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  preferences ShiftPreference[]
  assigned    FormSignup[]      @relation("Assignment")
  messages    Message[]

  @@index([formId, startsAt])
}

// A heading and text an admin adds to a signup form, such as instructions
// for filling out a waiver. Shown in position order.
model FormSection {
  id       String @id @default(cuid())
  title    String
  body     String @db.Text
  position Int

  formId String
  form   SignupForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, position])
}

// ─── Volunteers & form signups ───────────────────────────────────────────────

// Someone who has signed up through a signup form, identified by the email
// address they confirmed. Their details are the ones from their latest
// signup, and fill in the next form they open.
model Volunteer {
  id                String     @id @default(cuid())
  email             String     @unique // lowercased
  firstName         String
  lastName          String
  phone             String // E.164, e.g. +17655550123
  dateOfBirth       DateTime   @db.Date
  tShirtSize        TShirtSize
  hasDriversLicense Boolean
  // When they said on a signup form that they'd filled out Purdue's driver
  // approval form. Set while their approval is pending; cleared when an
  // admin approves or declines it.
  driverRequestedAt DateTime?
  // Seats in their car, counting the driver's: at least 3. Null until they
  // offer to drive others. (Before cars needed 3 seats, 0 meant no car.)
  carSeats          Int?
  // Builds they've done are counted from their signups (src/lib/form-
  // signups/experience.ts), and decide how experienced they are. When an
  // admin edits the number, such as for builds before the app, this is the
  // difference between theirs and the count, so later builds still add on.
  // Can be negative.
  buildsAdjustment  Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  signups           FormSignup[]
  driverApprovals   DriverApproval[]
  messageRecipients MessageRecipient[]
}

// An admin's decision on a volunteer's driver approval, kept as a record.
// A volunteer is an approved driver while their latest approval hasn't
// passed its end date or been revoked. Re-approving adds a new row.
model DriverApproval {
  id            String         @id @default(cuid())
  decision      DriverDecision
  // When the volunteer said they'd filled out the form.
  requestedAt   DateTime
  decidedAt     DateTime       @default(now())
  // The last day they're approved, in Indiana time. Approvals only.
  approvedUntil DateTime?      @db.Date
  // An approval ended early by an admin.
  revokedAt     DateTime?
  revokedByName String?

  // The admin who decided, with their name copied as on SignupForm.
  decidedByName String
  decidedById   String?
  decidedBy     User?   @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Restrict)

  @@index([volunteerId, decidedAt])
  @@index([decision, approvedUntil])
}

// A volunteer's signup for a build day, through its form. It keeps a copy
// of the details as they were last submitted for this form. Cancelling
// keeps the row; signing up again reuses it.
model FormSignup {
  id                String          @id @default(cuid())
  firstName         String
  lastName          String
  phone             String // E.164
  dateOfBirth       DateTime        @db.Date
  tShirtSize        TShirtSize
  hasDriversLicense Boolean
  // Null for signups made before the form asked. OWN_WAY when the form
  // didn't ask (see SignupForm.askTransportation).
  transportation    Transportation?
  // A copy of their car's seats when they offered to drive others.
  carSeats          Int?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // The build an admin assigned them to, on a form with custom assignments
  // (see SignupForm.assignmentsSavedAt). Null there means not placed.
  assignedShiftId String?
  assignedShift   Shift?  @relation("Assignment", fields: [assignedShiftId], references: [id], onDelete: SetNull)

  // Forms with signups can't be deleted, so this never cascades.
  formId String
  form   SignupForm @relation(fields: [formId], references: [id], onDelete: Restrict)

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Restrict)

  preferences   ShiftPreference[]
  groupRequests GroupRequest[]

  @@unique([formId, volunteerId])
  @@index([volunteerId])
  @@index([assignedShiftId])
}

// A build a volunteer said they could work at. Admins use these to place
// volunteers. A preference for a build that's since been cancelled is
// ignored but kept, so it counts again if the build is restored.
model ShiftPreference {
  signupId String
  signup   FormSignup @relation(fields: [signupId], references: [id], onDelete: Cascade)

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@id([signupId, shiftId])
  @@index([shiftId])
}

// Someone a volunteer asked, on their signup, to be placed with that day:
// at the same build, and in the same car if they can be. The other person
// is named by their Purdue email, so they can be asked for before they sign
// up, and one request is enough to group them. It's the lowest priority
// when placing volunteers, after everyone having a spot and a ride.
model GroupRequest {
  signupId String
  signup   FormSignup @relation(fields: [signupId], references: [id], onDelete: Cascade)

  email String // lowercased

  @@id([signupId, email])
  @@index([email])
}

// ─── Volunteer email verification ────────────────────────────────────────────
// Volunteers don't have accounts or sign in. Before filling out a signup
// form they confirm their email address with an emailed code, which lets
// them see and change their own signups. This is separate from the admins'
// Better Auth sign-in.

// A 6-digit code emailed to a volunteer. Only its hash is stored. Asking for
// a new code replaces the old one.
model VolunteerCode {
  id        String   @id @default(cuid())
  email     String // lowercased
  codeHash  String
  attempts  Int      @default(0) // wrong guesses so far
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// A browser that has verified an email address, for a couple of hours. The
// cookie holds a random token; only its hash is stored. Deleting the row
// forgets the email on that browser.
model VolunteerSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String // lowercased
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

// An email or text sent by an admin, usually to the volunteers at a build.
model Message {
  id        String         @id @default(cuid())
  channel   MessageChannel
  subject   String? // email only
  body      String         @db.Text
  createdAt DateTime       @default(now())

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  recipients MessageRecipient[]
}

// Delivery status for each volunteer a message was sent to.
model MessageRecipient {
  id         String         @id @default(cuid())
  to         String // email address or phone number at send time
  status     DeliveryStatus @default(QUEUED)
  providerId String? // Resend / Twilio message ID
  error      String?
  updatedAt  DateTime       @updatedAt

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([volunteerId])
}

// How many emails were sent through Resend each day, to warn the operations
// lead before reaching Resend's daily limit. Days are UTC calendar days, as
// Resend counts them.
model EmailDay {
  day      DateTime  @id @db.Date
  sent     Int       @default(0)
  // When the operations lead was warned that the limit is close. Once a day.
  warnedAt DateTime?
}
