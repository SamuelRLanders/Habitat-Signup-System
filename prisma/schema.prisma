// Database schema for the Habitat Signup System.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  VOLUNTEER // no longer used: only admins sign in
  ADMIN
}

// Builds are only ever seen by admins. Volunteers see shifts through each
// date's signup form, which leaves out a cancelled build's shifts.
enum BuildStatus {
  ACTIVE
  CANCELLED
}

// Whether volunteers can see a signup form. When they can fill it out is set
// by its open and close times.
enum FormStatus {
  DRAFT // admins only
  PUBLISHED // listed on the home page until it closes
}

enum SignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum Sex {
  FEMALE
  MALE
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum MessageChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ─── Users ───────────────────────────────────────────────────────────────────

// Everyone who signs in with an emailed code. Only admins can sign in, and
// they're added by the admin:add script, never from a form. VOLUNTEER users
// are left from when volunteers signed in too. Better Auth uses this as its
// "user" model, so name, emailVerified and image are fields it requires.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("") // kept in sync with the profile's name
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(VOLUNTEER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile  VolunteerProfile?
  sessions Session[]
  accounts Account[]

  registrations     Registration[]
  signups           Signup[]
  waiverAcceptances WaiverAcceptance[]
  messageRecipients MessageRecipient[]

  // Admin activity.
  buildsCreated Build[]
  formsCreated  SignupForm[]
  messagesSent  Message[]
}

// The details the signup form collects, kept apart from User so they aren't
// loaded with every session check. A new user has none until their first
// signup (or until they fill in their profile).
model VolunteerProfile {
  firstName             String
  lastName              String
  phone                 String // E.164, e.g. +17655550123
  address               String
  emergencyContactName  String
  emergencyContactPhone String // E.164
  dateOfBirth           DateTime    @db.Date
  sex                   Sex?
  tShirtSize            TShirtSize?
  // Null for details saved before the form asked; they're asked on their
  // next signup.
  hasDriversLicense     Boolean?
  smsOptIn              Boolean     @default(false)
  smsOptInAt            DateTime? // when consent was given (needed for SMS compliance)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Auth (managed by Better Auth) ───────────────────────────────────────────
// Field names follow Better Auth's schema.

// A logged-in browser. The cookie holds the token; deleting the row logs out.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A sign-in method linked to a user. Unused by email codes, but part of
// Better Auth's core schema (it would hold passkeys or Google sign-in).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived one-time values, such as hashed sign-in codes.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// One request for a sign-in code, kept briefly to limit how often codes can
// be sent to an email address or from an IP address.
model LoginCodeRequest {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ─── Builds & shifts ─────────────────────────────────────────────────────────

// A home Habitat is building, and the shifts volunteers can work there.
model Build {
  id          String      @id @default(cuid())
  name        String
  address     String
  description String?     @db.Text
  // IANA time zone the build's shift times are entered and shown in.
  timeZone    String      @default("America/Indiana/Indianapolis")
  status      BuildStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // The admin who created the build. Their name is copied here when the
  // build is created, so it stays the same if they're later renamed, lose
  // admin access, or their account is deleted.
  createdByName String
  createdById   String?
  createdBy     User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  shifts        Shift[]
  registrations Registration[]

  @@index([status])
}

// A block of time volunteers can sign up for at a build.
model Shift {
  id          String    @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int // total volunteer spots; each signup uses its registration's size
  notes       String?   @db.Text
  // Shifts with signups are cancelled rather than deleted, to keep a record.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  buildId String
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)

  signups  Signup[]
  messages Message[]

  @@index([buildId, startsAt])
}

// ─── Signup forms ────────────────────────────────────────────────────────────

// The signup form for one build day, shared with every group going out that
// day. Its shifts aren't stored: they're every shift on its date, across all
// builds, that isn't cancelled and whose build isn't cancelled. So there's at
// most one form per date, and each shift is on at most one form.
model SignupForm {
  id          String     @id @default(cuid())
  // The build day, in the Indiana time zone. Each shift's day is in its
  // build's time zone.
  date        DateTime   @unique @db.Date
  description String?    @db.Text
  status      FormStatus @default(DRAFT)
  // Volunteers can fill it out from opensAt until closesAt. A published form
  // is visible before it opens.
  opensAt     DateTime
  closesAt    DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The admin who created the form, with their name copied as on Build.
  createdByName String
  createdById   String?
  createdBy     User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sections FormSection[]

  @@index([status, date])
}

// A heading and text an admin adds to a signup form, such as instructions
// for filling out a waiver. Shown in position order.
model FormSection {
  id       String @id @default(cuid())
  title    String
  body     String @db.Text
  position Int

  formId String
  form   SignupForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, position])
}

// ─── Registrations & signups ─────────────────────────────────────────────────

// One submission of the signup form: a volunteer signing up alone (size 1),
// or leading a group (size > 1, including the leader) for one or more shifts
// of a build. Waivers are handled outside this app; the build's sections
// tell volunteers where to sign them.
model Registration {
  id          String    @id @default(cuid())
  groupName   String? // e.g. "First Baptist Youth Group"; null for individuals
  // Spots this registration takes on each of its confirmed shifts. The
  // leader can change it later if every shift still has room.
  size        Int       @default(1)
  // Secret token for the join link the leader shares with group members.
  // Null for individuals. The link stops working once the last shift starts.
  joinToken   String?   @unique
  // When the volunteer dismissed this registration's card after Habitat
  // cancelled the build. The card only stays hidden while the build is
  // cancelled, so it comes back if the build is restored.
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Builds with signups can't be deleted, so this never cascades.
  buildId String
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Restrict)

  leaderId String // the individual, or the group leader
  leader   User   @relation(fields: [leaderId], references: [id])

  signups           Signup[]
  groupMembers      GroupMember[]
  waiverAcceptances WaiverAcceptance[]

  @@index([leaderId])
  @@index([buildId])
}

// A registration's spot(s) on one shift. Each shift can be cancelled on its
// own; the registration's other shifts are unaffected.
model Signup {
  id          String       @id @default(cuid())
  status      SignupStatus @default(CONFIRMED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cancelledAt DateTime?

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Always the registration's leader. Stored here so a volunteer can only
  // have one signup per shift. Signing up again after cancelling reuses the
  // row and moves it to the new registration.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([shiftId, userId])
  @@index([registrationId])
  @@index([userId])
}

// A group member who joined through the leader's link. Group
// members don't have user accounts; this row is how they're identified, and
// their phone number is used to text them on build days.
model GroupMember {
  id          String    @id @default(cuid())
  legalName   String
  dateOfBirth DateTime  @db.Date
  phone       String // E.164
  smsOptIn    Boolean   @default(false)
  smsOptInAt  DateTime?
  createdAt   DateTime  @default(now())

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  waiverAcceptance  WaiverAcceptance?
  messageRecipients MessageRecipient[]

  @@index([registrationId])
}

// ─── Waivers (no longer used) ────────────────────────────────────────────────

// Volunteers used to sign a built-in waiver as part of signing up. Waivers
// are now signed outside the app, linked from each build's sections. These
// tables only hold signatures made before that change.

// Waiver text is versioned and never edited in place.
model Waiver {
  id        String   @id @default(cuid())
  version   Int      @unique
  title     String
  body      String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  acceptances WaiverAcceptance[]
}

// An immutable record of someone accepting a waiver version for a
// registration, by typing their full legal name. The signer is either a user
// (the leader or an individual) or a group member, never both; a database
// check enforces this. Deleting anything a record points to is blocked.
model WaiverAcceptance {
  id         String   @id @default(cuid())
  signedName String // typed full legal name, exactly as entered
  signedAt   DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  waiverId String
  waiver   Waiver @relation(fields: [waiverId], references: [id])

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  groupMemberId String?      @unique
  groupMember   GroupMember? @relation(fields: [groupMemberId], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([userId])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

// An email or text sent by an admin, usually to everyone signed up for a shift.
model Message {
  id        String         @id @default(cuid())
  channel   MessageChannel
  subject   String? // email only
  body      String         @db.Text
  createdAt DateTime       @default(now())

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  recipients MessageRecipient[]
}

// Delivery status for each recipient of a message: a user or a group member
// (never both; a database check enforces this).
model MessageRecipient {
  id         String         @id @default(cuid())
  to         String // email address or phone number at send time
  status     DeliveryStatus @default(QUEUED)
  providerId String? // Resend / Twilio message ID
  error      String?
  updatedAt  DateTime       @updatedAt

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  groupMemberId String?
  groupMember   GroupMember? @relation(fields: [groupMemberId], references: [id], onDelete: Restrict)

  @@index([messageId])
}
