// Database schema for the Habitat Signup System.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OpportunityStatus {
  DRAFT // visible to admins only
  PUBLISHED // open for signups
  CLOSED // visible, but no longer accepting signups
  CANCELLED
}

enum SignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum MessageChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ─── Admins ──────────────────────────────────────────────────────────────────

// Staff who can log in to the admin dashboard.
// Auth.js session/token tables will be added when admin login is wired up.
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  messages      Message[]
}

// ─── Opportunities ───────────────────────────────────────────────────────────

model Opportunity {
  id          String            @id @default(cuid())
  title       String
  description String            @db.Text
  location    String // display name, e.g. "Oak Street Build Site"
  address     String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int // total volunteer spots; group signups use groupSize spots
  minimumAge  Int?
  status      OpportunityStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdById String
  createdBy   Admin  @relation(fields: [createdById], references: [id])

  signups  Signup[]
  messages Message[]

  @@index([status, startsAt])
}

// ─── Volunteers & signups ────────────────────────────────────────────────────

// Volunteers never log in. A returning volunteer is matched by email.
model Volunteer {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  phone       String?
  smsOptIn    Boolean   @default(false)
  smsOptInAt  DateTime? // when consent was given (needed for SMS compliance)
  dateOfBirth DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  signups           Signup[]
  groupMemberships  GroupMember[]
  waiverAcceptances WaiverAcceptance[]
  messageRecipients MessageRecipient[]
}

// One volunteer signing up for one opportunity: either alone, or as the
// leader of a group (groupSize > 1).
model Signup {
  id          String       @id @default(cuid())
  status      SignupStatus @default(CONFIRMED)
  groupName   String? // e.g. "First Baptist Youth Group"; null for individuals
  groupSize   Int          @default(1) // includes the leader
  // Secret token for the "view or cancel your signup" link in the confirmation email.
  manageToken String       @unique @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cancelledAt DateTime?

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  volunteerId String // the individual, or the group leader
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])

  groupMembers      GroupMember[]
  waiverAcceptances WaiverAcceptance[]

  @@unique([opportunityId, volunteerId])
  @@index([volunteerId])
}

// A member of a group signup, other than the leader. The leader may know only
// a name at signup time; the member is linked to a Volunteer record once they
// open their waiver link and fill in their details.
model GroupMember {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  dateOfBirth DateTime? @db.Date
  // Secret token for this member's personal waiver link.
  waiverToken String    @unique @default(uuid())
  createdAt   DateTime  @default(now())

  signupId String
  signup   Signup @relation(fields: [signupId], references: [id], onDelete: Cascade)

  volunteerId String?
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id])

  @@index([signupId])
}

// ─── Waivers ─────────────────────────────────────────────────────────────────

// Waiver text is versioned and never edited in place. To change the text,
// create a new version and make it the active one.
model Waiver {
  id        String   @id @default(cuid())
  version   Int      @unique
  title     String
  body      String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  acceptances WaiverAcceptance[]
}

// An immutable record of a volunteer accepting a specific waiver version.
model WaiverAcceptance {
  id         String   @id @default(cuid())
  signedName String // typed-name signature
  signedAt   DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  // Minors: a parent or guardian accepts on their behalf.
  isMinor              Boolean @default(false)
  guardianName         String?
  guardianEmail        String?
  guardianRelationship String?

  waiverId String
  waiver   Waiver @relation(fields: [waiverId], references: [id])

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])

  // The signup during which the waiver was accepted, if any.
  signupId String?
  signup   Signup? @relation(fields: [signupId], references: [id], onDelete: SetNull)

  @@index([volunteerId, waiverId])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

// An email or text sent by an admin, usually to everyone signed up for an opportunity.
model Message {
  id        String         @id @default(cuid())
  channel   MessageChannel
  subject   String? // email only
  body      String         @db.Text
  createdAt DateTime       @default(now())

  sentById String
  sentBy   Admin  @relation(fields: [sentById], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  recipients MessageRecipient[]
}

// Delivery status for each recipient of a message.
model MessageRecipient {
  id         String         @id @default(cuid())
  to         String // email address or phone number at send time
  status     DeliveryStatus @default(QUEUED)
  providerId String? // Resend / Twilio message ID
  error      String?
  updatedAt  DateTime       @updatedAt

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])

  @@index([messageId])
}
